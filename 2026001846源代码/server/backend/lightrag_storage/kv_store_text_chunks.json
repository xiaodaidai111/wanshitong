  "doc-c89f4e3350d0dc40e69e4be5076021cf-chunk-000": {
    "tokens": 93,
    "content": "【发动机异响排查】\n关键词：异响, 气门间隙, 链条, 轴承, 磨损, 润滑不足\n发动机异响可能来自气门间隙异常、链条磨损、轴承磨损或润滑不足。\n排查时应记录异响出现工况，例如冷机、热机、怠速、加速或负载状态。",
    "chunk_order_index": 0,
    "full_doc_id": "doc-c89f4e3350d0dc40e69e4be5076021cf",
    "file_path": "unknown_source",
    "llm_cache_list": [
      "default:extract:8cd9ae0053ecdb0899359d150616ec43",
      "default:extract:de4aafec842a675d065b5f67b65c451c"
    ],
    "create_time": 1781616012,
    "update_time": 1781616019,
    "_id": "doc-c89f4e3350d0dc40e69e4be5076021cf-chunk-000"
  },
  "doc-fbe68eca2b811210706dd57400f5eae0-chunk-000": {
    "tokens": 75,
    "content": "【机油与润滑保养】\n关键词：机油, 润滑, 保养, 油位, 温升异常\n机油与润滑保养关注油位、油品状态、换油周期、泄漏和润滑不足风险。\n润滑不足可能引发异常磨损、温升异常和发动机异响。",
    "chunk_order_index": 0,
