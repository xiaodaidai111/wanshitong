  "doc-807f05635e8bb4b35f0576eb82f8be84-chunk-000": {
    "tokens": 93,
    "content": "【专业检修对象：摩托车发动机】\n关键词：检修对象, 发动机, 点火, 燃油, 润滑, 异响\n摩托车发动机节点关联维修手册、点火系统检查、燃油供给检查、发动机异响和机油润滑保养。\n该对象可作为设备型号、故障图片、文本现象共同检索的基础入口。",
    "chunk_order_index": 0,
    "full_doc_id": "doc-807f05635e8bb4b35f0576eb82f8be84",
    "file_path": "unknown_source",
    "llm_cache_list": [
      "default:extract:f48b6a999e4160884acc0fac63137163",
      "default:extract:d2384f848a9e6ba711bfa966cb55d891"
    ],
